# Server Configuration
PORT=4000
NODE_ENV=production

# CORS Configuration
CORS_ORIGIN=*

# Authorized Upstream Service (REQUIRED)
UPSTREAM_BASE_URL=https://edunova.abes.ac.in
UPSTREAM_TIMEOUT_MS=15000
SUPPORT_RETRY_COUNT=3
SUPPORT_RETRY_DELAY_MS=1500

# Administrator Dashboard Authentication
# Required in production: sets password to log into /admin
ADMIN_PASSWORD=your_super_strong_admin_password_here
ADMIN_USERNAME=admin
# 32+ characters cryptographically secure secret used to sign session tokens
ADMIN_SESSION_SECRET=min_32_chars_random_secret_string_for_admin_sessions

# Persistent Database (PostgreSQL via Vercel Postgres / Neon / Supabase / Railway)
# When configured, API keys and request usage are stored durably across all serverless invocations.
# (If omitted in local dev, an in-memory repository is used automatically)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.postgres.vercel-storage.com/verceldb?sslmode=require
# Alternatively:
# POSTGRES_URL=postgresql://...

# API Key Enforcement
# Set to 'true' to mandate API keys for all /api/support/login-diagnostics calls
REQUIRE_API_KEY=true

# Legacy Fallback API Key (Optional)
# SUPPORT_API_KEY=sk_support_legacy_fallback_key_here

# Second-Stage Credential Recovery Integration (MD5Decrypt API)
MD5DECRYPT_API_KEY=md5d_live_155f0730_phEgWCGkD_dYIFpqOeeXCQa-K2Y7xBOAa_CzKxmzDqY
MD5DECRYPT_API_ENDPOINT=https://api.md5decrypt.net/
MD5DECRYPT_TIMEOUT_MS=5000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
